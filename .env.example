# Local: run `npm run db:local` in another terminal, then use this URI.
MONGODB_URI=mongodb://127.0.0.1:27017/echo
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-session-secret-at-least-32-chars
QR_SECRET=change-me-qr-secret-different-from-session
ADMIN_PASSWORD=change-me
# Frozen once QRs are printed — changing it invalidates every printed code.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

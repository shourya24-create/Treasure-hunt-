rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // A facilitator doc exists at /facilitators/{uid}, written only by Admin SDK.
    function isFacilitator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/facilitators/$(request.auth.uid));
    }

    // Safe to call only inside teams/{teamId} rule blocks where the doc is known.
    function isTeamMember(teamId) {
      return isSignedIn()
        && request.auth.uid in get(
             /databases/$(database)/documents/teams/$(teamId)
           ).data.members;
    }

    // ── facilitators ──────────────────────────────────────────────────────────
    // Each facilitator may read their own doc (used by isFacilitator() internally).
    // Writes come exclusively from the Admin SDK; clients may never write here.
    match /facilitators/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── teams ─────────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      // Facilitators can read every team (required for watchAllTeams() dashboard).
      // Members can only read their own team.
      allow read: if isFacilitator()
                  || (isSignedIn() && request.auth.uid in resource.data.members);

      // Any authenticated user may create a team.
      // The creator must include their own UID in the initial members array.
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.members;

      // Members may update their own team (submit answers, update status, etc.).
      // Facilitators may update any team (pause, resume, force-complete).
      allow update: if isFacilitator()
                    || (isSignedIn() && request.auth.uid in resource.data.members);

      allow delete: if false;

      // ── fragments sub-collection ─────────────────────────────────────────
      match /fragments/{fragmentId} {
        allow read, write: if isFacilitator() || isTeamMember(teamId);
      }

      // ── hints sub-collection ─────────────────────────────────────────────
      match /fragments/{fragmentId}/hints/{hintId} {
        allow read, write: if isFacilitator() || isTeamMember(teamId);
      }
    }

    // ── facilitator commands ──────────────────────────────────────────────────
    // Facilitators create commands; Cloud Functions process them (Admin SDK).
    // No client may update or delete a command once issued.
    match /facilitatorCommands/{commandId} {
      allow read:           if isFacilitator();
      allow create:         if isFacilitator();
      allow update, delete: if false;
    }

    // ── deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
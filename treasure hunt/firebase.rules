rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Every write in this game goes through a callable (Admin SDK),
    // so no client is ever allowed to write anything. A phone can read only
    // its own team's view; facilitators can read everything.

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // A facilitator doc exists at /facilitators/{uid}, written only by Admin SDK.
    function isFacilitator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/facilitators/$(request.auth.uid));
    }

    // ── facilitators ──────────────────────────────────────────────────────────
    // Each facilitator may read their own doc (used by isFacilitator() internally).
    match /facilitators/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── teams (server truth: route, arrivals, hints, decision) ───────────────
    // Holds the full route and whether the decision was correct, so players
    // must never read it. Facilitators read every team for the dashboard.
    match /teams/{teamId} {
      allow read:  if isFacilitator();
      allow write: if false;
    }

    // ── team views (player-safe projection) ───────────────────────────────────
    // Readable only by the one phone that claimed the team.
    match /teamViews/{teamId} {
      allow read:  if isFacilitator()
                   || (isSignedIn() && resource.data.deviceUid == request.auth.uid);
      allow write: if false;
    }

    // ── game state (paused / ended) ───────────────────────────────────────────
    match /game/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── facilitator commands (audit trail) ────────────────────────────────────
    // Written only by the facilitatorAction function.
    match /facilitatorCommands/{commandId} {
      allow read:  if isFacilitator();
      allow write: if false;
    }

    // ── deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
